<Window x:Class="NusaNotch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="{x:Null}"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" AllowDrop="True"
        Width="540" Height="200">
    <Border x:Name="Notch" Background="#080F20" CornerRadius="0,0,18,18"
            BorderBrush="#00A6FF" BorderThickness="0,0,0,1.5"
            HorizontalAlignment="Center" VerticalAlignment="Top"
            Width="220" Height="34" ClipToBounds="True" AllowDrop="True">
        <Grid>
            <!-- CLOSED VIEW -->
            <Grid x:Name="ClosedView" Margin="12,0">
                <!-- Baterai di Kiri (Kuning Persona / Hijau) -->
                <TextBlock x:Name="BatteryText" Foreground="#FFC72C" FontWeight="Bold" FontSize="12" 
                           VerticalAlignment="Center" HorizontalAlignment="Left" Text="100%"/>

                <!-- Muka Chiikawa di Tengah dengan Gradasi Velvet Blue -->
                <Viewbox Width="54" Height="27" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="60" Height="30" x:Name="ChiikawaCanvas">
                        <Canvas.Resources>
                            <RadialGradientBrush x:Key="ChiikawaTexture" Center="0.5,0.35" GradientOrigin="0.5,0.2" RadiusX="0.65" RadiusY="0.65">
                                <GradientStop Color="#FFFFFF" Offset="0.0"/>
                                <GradientStop Color="#E0F4FF" Offset="0.6"/>
                                <GradientStop Color="#B3E5FF" Offset="1.0"/>
                            </RadialGradientBrush>
                        </Canvas.Resources>

                        <!-- Telinga -->
                        <Path Data="M 12,9 C 10,2 18,2 18,9 Z" Fill="{StaticResource ChiikawaTexture}"/>
                        <Path Data="M 42,9 C 42,2 50,2 48,9 Z" Fill="{StaticResource ChiikawaTexture}"/>

                        <!-- Kepala -->
                        <Border Canvas.Left="6" Canvas.Top="5" Width="48" Height="23" CornerRadius="12,12,13,13" 
                                Background="{StaticResource ChiikawaTexture}"/>

                        <!-- Pipi Merah / Pink Blush -->
                        <Ellipse Canvas.Left="9" Canvas.Top="15" Width="9" Height="5" Fill="#FF6B8B" Opacity="0.85"/>
                        <Ellipse Canvas.Left="42" Canvas.Top="15" Width="9" Height="5" Fill="#FF6B8B" Opacity="0.85"/>

                        <!-- Ekspresi 1: Normal -->
                        <Canvas x:Name="FaceNormal" Visibility="Visible">
                            <Path Data="M 16,8.5 Q 19,10.5 22,9" Stroke="#080F20" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 38,9 Q 41,10.5 44,8.5" Stroke="#080F20" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="16" Canvas.Top="11" Width="6" Height="8" Fill="#080F20"/>
                            <Ellipse Canvas.Left="17" Canvas.Top="12" Width="2.2" Height="3.2" Fill="White"/>
                            <Ellipse Canvas.Left="38" Canvas.Top="11" Width="6" Height="8" Fill="#080F20"/>
                            <Ellipse Canvas.Left="39" Canvas.Top="12" Width="2.2" Height="3.2" Fill="White"/>
                            <Path Data="M 27,18 Q 30,21 33,18" Stroke="#080F20" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>

                        <!-- Ekspresi 2: Kedip -->
                        <Canvas x:Name="FaceBlink" Visibility="Collapsed">
                            <Path Data="M 15,15 Q 19,11 23,15" Stroke="#080F20" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 37,15 Q 41,11 45,15" Stroke="#080F20" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 27,18 Q 30,21 33,18" Stroke="#080F20" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>

                        <!-- Ekspresi 3: Cute -->
                        <Canvas x:Name="FaceCute" Visibility="Collapsed">
                            <Path Data="M 16,7.5 Q 19,10 22,8.5" Stroke="#080F20" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 38,8.5 Q 41,10 44,7.5" Stroke="#080F20" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="15" Canvas.Top="10" Width="7" Height="9" Fill="#080F20"/>
                            <Ellipse Canvas.Left="16" Canvas.Top="11" Width="3" Height="4" Fill="White"/>
                            <Ellipse Canvas.Left="19" Canvas.Top="14" Width="1.5" Height="1.5" Fill="White"/>
                            <Ellipse Canvas.Left="38" Canvas.Top="10" Width="7" Height="9" Fill="#080F20"/>
                            <Ellipse Canvas.Left="39" Canvas.Top="11" Width="3" Height="4" Fill="White"/>
                            <Ellipse Canvas.Left="42" Canvas.Top="14" Width="1.5" Height="1.5" Fill="White"/>
                            <Path Data="M 28,18 Q 30,22 32,18 Z" Fill="#080F20"/>
                        </Canvas>

                        <!-- Ekspresi 4: Happy -->
                        <Canvas x:Name="FaceHappy" Visibility="Collapsed">
                            <Path Data="M 15,13 Q 19,17 23,13" Stroke="#080F20" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 37,13 Q 41,17 45,13" Stroke="#080F20" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Path Data="M 27,17 Q 30,22 33,17 Z" Fill="#080F20"/>
                        </Canvas>
                    </Canvas>
                </Viewbox>

                <!-- Jam di Kanan (Sky Cyan) -->
                <TextBlock x:Name="ClockText" Foreground="#50C8FF" FontWeight="Bold" FontSize="14" 
                           VerticalAlignment="Center" HorizontalAlignment="Right" Text="22:47"/>
            </Grid>

            <!-- RESTING: Sepasang Mata Cyan -->
            <StackPanel x:Name="EyesView" Orientation="Horizontal" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Opacity="0">
                <Ellipse x:Name="EyeL" Width="7" Height="12" Fill="#50C8FF" Margin="0,0,14,0"/>
                <Ellipse x:Name="EyeR" Width="7" Height="12" Fill="#50C8FF"/>
            </StackPanel>

            <!-- OPEN: Container Modul Multi-Halaman -->
            <Grid x:Name="OpenContainer" Opacity="0" Visibility="Collapsed">
                <ContentControl x:Name="OpenHost" Margin="0"/>

                <!-- Tombol Navigasi P3 Styled -->
                <Button x:Name="BtnPrevModule" Content="‹" Click="BtnPrevModule_Click"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10,0,0,8"
                        Width="24" Height="24" Background="#0D1930" Foreground="#FFC72C"
                        BorderBrush="#00A6FF" BorderThickness="1" FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnNextModule" Content="›" Click="BtnNextModule_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,10,8"
                        Width="24" Height="24" Background="#0D1930" Foreground="#FFC72C"
                        BorderBrush="#00A6FF" BorderThickness="1" FontSize="14" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Indikator Dots -->
                <StackPanel x:Name="PageDotsContainer" Orientation="Horizontal"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
            </Grid>
        </Grid>
    </Border>
</Window>