<UserControl x:Class="NusaNotch.TodoModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Height="200" Background="Transparent">

    <Grid Margin="18,10,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Input Bar Persona Style -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="105"/>
                <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>

            <!-- Textbox Title -->
            <TextBox x:Name="TxtTaskTitle" Grid.Column="0" Height="30" Background="#0D1930" Foreground="White" 
                     BorderBrush="#00A6FF" BorderThickness="1.2" Padding="8,4" FontSize="12" 
                     VerticalContentAlignment="Center" Margin="0,0,6,0">
                <TextBox.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </TextBox.Resources>
            </TextBox>

            <!-- Dropdown Time -->
            <ComboBox x:Name="CmbDue" Grid.Column="1" Height="30" SelectedIndex="0" Margin="0,0,6,0"
                      Background="#0D1930" Foreground="#50C8FF" BorderBrush="#00A6FF" BorderThickness="1.2" FontSize="11">
                <ComboBoxItem Content="Tanpa Jam"/>
                <ComboBoxItem Content="+15 Menit"/>
                <ComboBoxItem Content="+1 Jam"/>
                <ComboBoxItem Content="+3 Jam"/>
            </ComboBox>

            <!-- Button Tambah (Persona Gold) -->
            <Button Grid.Column="2" Content="Tambah" Click="BtnAdd_Click" Height="30" 
                    Background="#FFC72C" Foreground="#080F20" FontWeight="Bold" FontSize="12" 
                    BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- List Todos -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ListTodos">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#0D1930" BorderBrush="#1E3A60" BorderThickness="1" 
                                CornerRadius="8" Margin="0,0,0,6" Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0" IsChecked="{Binding Done}" Click="CheckBox_Click" 
                                          VerticalAlignment="Center" Margin="0,0,10,0"/>

                                <!-- Title -->
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="White" FontSize="12" 
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                <!-- Countdown Time Text (Electric Cyan / Gold) -->
                                <TextBlock Grid.Column="2" Text="{Binding DueText}" Foreground="#FFC72C" FontSize="11" 
                                           FontWeight="Bold" VerticalAlignment="Center" Margin="10,0"/>

                                <!-- Delete Button -->
                                <Button Grid.Column="3" Content="✕" Click="BtnDelete_Click" Tag="{Binding Id}" 
                                        Foreground="#FF5555" Background="Transparent" BorderThickness="0" 
                                        FontWeight="Bold" FontSize="12" Cursor="Hand"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>