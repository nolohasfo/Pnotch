<UserControl x:Class="NusaNotch.ClipboardModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="200" Width="520">
    <UserControl.Resources>
        <!-- Style Kartu Snippet P3R -->
        <Style x:Key="SnippetCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#0D1930"/>
            <Setter Property="BorderBrush" Value="#1E3A60"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#00A6FF"/>
                    <Setter Property="Background" Value="#152848"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- TAMPILAN UTAMA CLIPBOARD MODULE -->
        <Grid Margin="12,10,12,30">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ROW 0: Header & Tombol Tambah Snippet -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📋 VELVET SNIPPETS" Foreground="#FFC72C" FontWeight="Bold" FontSize="13"/>
                    <Border Background="#1E3A60" CornerRadius="10" Margin="10,0,0,0" Padding="6,1">
                        <TextBlock x:Name="TxtTotalCount" Text="0 Snippets" Foreground="#50C8FF" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <!-- Tombol Add Snippet -->
                <Button x:Name="BtnAddSnippet" Content="⊕ Add Snippet" Click="BtnAddSnippet_Click"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#0D1930" Foreground="#FFC72C" BorderBrush="#00A6FF" BorderThickness="1"
                        Padding="10,3" FontSize="11" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ROW 1: Daftar Snippet Scrollable -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SnippetListPanel">
                    <!-- Item digenerate dinamis via C# -->
                </StackPanel>
            </ScrollViewer>

            <!-- Empty State -->
            <StackPanel x:Name="EmptyStatePanel" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Belum ada snippet tersimpan." Foreground="#80E0FF" FontSize="12" HorizontalAlignment="Center" Opacity="0.7"/>
                <TextBlock Text="Klik '⊕ Add Snippet' untuk menyimpan teks/rekening/command." Foreground="#50C8FF" FontSize="10" HorizontalAlignment="Center" Margin="0,4,0,0" Opacity="0.5"/>
            </StackPanel>
        </Grid>

        <!-- TOAST FEEDBACK: "• Copied!" -->
        <Border x:Name="ToastBorder" Background="#00A6FF" CornerRadius="12" Padding="12,4"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Text="• Copied to Clipboard!" Foreground="#080F20" FontWeight="Bold" FontSize="11"/>
        </Border>

        <!-- OVERLAY MODAL: Add Snippet Dialog -->
        <Grid x:Name="SnippetOverlay" Background="#EA080F20" Visibility="Collapsed">
            <Border Background="#0D1930" BorderBrush="#00A6FF" BorderThickness="1.5" CornerRadius="12"
                    Width="380" Height="165" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="ADD QUICK SNIPPET" Foreground="#FFC72C" FontWeight="Bold" FontSize="12"/>

                    <!-- Input Label -->
                    <TextBox x:Name="TxtSnippetLabel" Grid.Row="1" Margin="0,8,0,6" Height="26"
                             Background="#080F20" Foreground="#50C8FF" BorderBrush="#1E3A60" BorderThickness="1"
                             Padding="6,3" FontSize="11" VerticalContentAlignment="Center"
                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"/>

                    <!-- Input Isi Teks Snippet -->
                    <TextBox x:Name="TxtSnippetContent" Grid.Row="2" Margin="0,0,0,8" VerticalContentAlignment="Top"
                             Background="#080F20" Foreground="White" BorderBrush="#1E3A60" BorderThickness="1"
                             Padding="6,4" FontSize="11" TextWrapping="Wrap" AcceptsReturn="True"
                             GotFocus="Input_GotFocus" LostFocus="Input_LostFocus"/>

                    <!-- Buttons Overlay -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Click="BtnCancelOverlay_Click"
                                Background="Transparent" Foreground="#80E0FF" BorderThickness="0"
                                Margin="0,0,8,0" Padding="10,3" FontSize="11" Cursor="Hand"/>
                        <Button Content="Save Snippet" Click="BtnSaveSnippet_Click"
                                Background="#00A6FF" Foreground="#080F20" BorderThickness="0"
                                Padding="12,4" FontWeight="Bold" FontSize="11" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>