<UserControl x:Class="NusaNotch.MediaModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Height="200" Background="Transparent">
    <Grid Margin="18,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Album Art Card -->
        <Border Grid.Column="0" CornerRadius="12" Background="#0D1930" 
                BorderBrush="#00A6FF" BorderThickness="1.5" ClipToBounds="True">
            <Grid>
                <Image x:Name="ImgCover" Stretch="UniformToFill"/>
                <TextBlock x:Name="TxtNoArt" Text="P3 SOUND" Foreground="#50C8FF" FontSize="12" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Visible"/>
            </Grid>
        </Border>

        <!-- Media Info & Controls -->
        <Grid Grid.Column="1" Margin="16,4,0,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Judul Lagu -->
            <TextBlock x:Name="TxtTitle" Grid.Row="0" Text="Tidak Ada Media" Foreground="White" 
                       FontSize="16" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>

            <!-- Nama Artis -->
            <TextBlock x:Name="TxtArtist" Grid.Row="1" Text="-" Foreground="#80E0FF" 
                       FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>

            <!-- Progress Bar Line -->
            <ProgressBar x:Name="ProgMedia" Grid.Row="2" Height="4" VerticalAlignment="Center" 
                         Background="#1E3A60" Foreground="#00A6FF" BorderThickness="0" Minimum="0" Maximum="100"/>

            <!-- Tombol Kontrol -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnPrev" Content="⏮" Click="BtnPrev_Click" Width="36" Height="36" 
                        Background="Transparent" Foreground="#50C8FF" BorderThickness="0" FontSize="16" Cursor="Hand"/>
                
                <!-- Play Button dalam Warna Persona Gold (#FFC72C) -->
                <Button x:Name="BtnPlayPause" Content="▶" Click="BtnPlayPause_Click" Width="44" Height="44" Margin="12,0" 
                        Background="#FFC72C" Foreground="#080F20" BorderThickness="0" FontSize="18" FontWeight="Bold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="22">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button x:Name="BtnNext" Content="⏭" Click="BtnNext_Click" Width="36" Height="36" 
                        Background="Transparent" Foreground="#50C8FF" BorderThickness="0" FontSize="16" Cursor="Hand"/>

                <Button x:Name="BtnLyrics" Content="🎤" Click="BtnLyrics_Click" Width="36" Height="36" Margin="12,0,0,0"
                        Background="Transparent" Foreground="#FFC72C" BorderThickness="0" FontSize="14" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Overlay Lirik Persona 3 Theme -->
        <Grid x:Name="LyricsOverlay" Grid.ColumnSpan="2" Background="#FA080F20" Visibility="Collapsed">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Lyrics Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="4" Width="24" Height="24" Background="#0D1930" BorderBrush="#00A6FF" BorderThickness="1" Margin="0,0,8,0" ClipToBounds="True">
                            <Image x:Name="LyricsSmallCover" Stretch="UniformToFill"/>
                        </Border>
                        <TextBlock x:Name="LyricsTxtTitle" Foreground="#50C8FF" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                    </StackPanel>
                    <Button Content="✕" Click="BtnCloseLyrics_Click" Foreground="#FFC72C" Background="Transparent" BorderThickness="0" 
                            HorizontalAlignment="Right" FontSize="14" FontWeight="Bold" Cursor="Hand"/>
                </Grid>

                <!-- Lyrics Scroll Container -->
                <ScrollViewer x:Name="LyricsContainer" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="TxtNoLyrics" Text="Lirik tidak ditemukan" Foreground="#80E0FF" FontSize="13" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,0" Visibility="Visible"/>
                        <TextBlock x:Name="TxtLyrics" Foreground="White" FontSize="13" LineHeight="20" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>