<UserControl x:Class="NusaNotch.ShelfModule"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Height="200" Background="Transparent"
             AllowDrop="True" DragEnter="Shelf_DragEnter" DragLeave="Shelf_DragLeave" Drop="Shelf_Drop">

    <Grid Margin="18,10,18,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Shelf -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <TextBlock Text="Shelf" Foreground="#50C8FF" FontSize="16" FontWeight="Bold" Margin="0,0,12,0"/>
                <Button Content="Clear All" Click="BtnClear_Click" Padding="10,3" Background="#0D1930" Foreground="#FFC72C" 
                        BorderBrush="#00A6FF" BorderThickness="1" FontSize="11" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Text Signature Kanan Atas -->
            <TextBlock Text="julio begadang untuk ini" Foreground="#FFC72C" FontSize="11" FontStyle="Italic" 
                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Right" Opacity="0.85"/>
        </Grid>

        <!-- Container Area Drop -->
        <Grid Grid.Row="1">
            <!-- Garis Putus-Putus Wadah Shelf (Sky Cyan) -->
            <Rectangle Stroke="#00A6FF" StrokeDashArray="4 3" StrokeThickness="1.5" RadiusX="12" RadiusY="12"/>

            <!-- Pesan Teks Saat Kosong -->
            <StackPanel x:Name="EmptyPrompt" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                <TextBlock Text="📥" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Drop files here" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center"/>
                <TextBlock Text="Drag out to remove • click to open" Foreground="#80E0FF" FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"/>
            </StackPanel>

            <!-- Daftar Item -->
            <ScrollViewer VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto" Margin="8,6">
                <ItemsControl x:Name="ListShelfItems">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="95" Height="118" Background="#0D1930" BorderBrush="#1E3A60" BorderThickness="1" 
                                    CornerRadius="10" Margin="4,0" Padding="6" Cursor="Hand" ToolTip="{Binding FilePath}" 
                                    MouseDown="Item_MouseDown" MouseMove="Item_MouseMove" MouseLeftButtonUp="Item_MouseLeftButtonUp">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="45"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Tombol Hapus ✕ -->
                                    <Button Grid.Row="0" Content="✕" Foreground="#80E0FF" Background="Transparent" 
                                            BorderThickness="0" Click="BtnRemoveItem_Click" Tag="{Binding FilePath}" 
                                            HorizontalAlignment="Right" VerticalAlignment="Top" 
                                            Margin="0,-2,-2,0" FontWeight="Bold" FontSize="11" Cursor="Hand"/>

                                    <!-- Ikon Visual Folder (Gold) / File (Cyan) -->
                                    <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Data="M 2,6 C 2,4 4,2 6,2 L 14,2 L 18,6 L 34,6 C 36,6 38,8 38,10 L 38,26 C 38,28 36,30 34,30 L 6,30 C 4,30 2,28 2,26 Z" 
                                              Fill="#FFC72C" Width="34" Height="26" Stretch="Uniform"
                                              Visibility="{Binding IsFolderVisibility}"/>
                                        <Path Data="M 4,2 L 22,2 L 32,12 L 32,38 C 32,40 30,42 28,42 L 4,42 C 2,42 0,40 0,38 L 0,6 C 0,4 2,2 4,2 Z M 20,4 L 20,14 L 30,14" 
                                              Fill="#00A6FF" Width="26" Height="30" Stretch="Uniform"
                                              Visibility="{Binding IsFileVisibility}"/>
                                    </Grid>

                                    <!-- Nama File -->
                                    <TextBlock Grid.Row="2" Text="{Binding FileName}" Foreground="White" FontSize="11" 
                                               FontWeight="SemiBold" TextAlignment="Center" TextWrapping="Wrap" 
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>

                                    <!-- Ukuran / Tipe -->
                                    <TextBlock Grid.Row="3" Text="{Binding FileInfoText}" Foreground="#50C8FF" FontSize="9" 
                                               TextAlignment="Center" Margin="0,2,0,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Layer Highlight Saat File Ditarik di Atas Shelf -->
            <Border x:Name="DragOverlay" Background="#EE080F20" CornerRadius="12" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📂" FontSize="30" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Release to add" Foreground="#FFC72C" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>